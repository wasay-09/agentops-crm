# --- server ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://localhost:5432/agentops_gateway

# --- CRM tool API ---
CRM_TOOL_URL=http://localhost:3000
CRM_TOOL_TOKEN=dev-tool-token

# --- providers (leave empty to use the deterministic mock) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Substitute unavailable models with the mock simulator (dev/CI). Set false in production.
LLM_MOCK_FALLBACK=true
MOCK_LATENCY_MS=250

# --- seed keys (dev only; use real secrets in deployed environments) ---
SEED_SALES_API_KEY=ak_dev_sales_00000000000000000000
SEED_ADMIN_API_KEY=ak_dev_admin_00000000000000000000

# --- ops ---
RUN_MIGRATIONS=true
SEED_ON_START=true
ALLOW_FAULT_INJECTION=true
RATE_LIMIT_PER_MINUTE=120
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
